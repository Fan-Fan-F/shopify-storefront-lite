# Shopify Storefront Lite Configuration
# Set mode to 'mock' for instant offline development and testing without credentials.
SHOPIFY_STORE_MODE=mock

# Live Shopify Storefront API credentials (only needed if SHOPIFY_STORE_MODE=live)
SHOPIFY_STORE_DOMAIN=your-shop-domain.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token-placeholder
SHOPIFY_STOREFRONT_API_VERSION=2025-10
