{
  "name": "shopify-storefront-lite",
  "version": "1.0.0",
  "description": "Framework-agnostic, lightweight Shopify storefront & shopping cart scaffold with zero bloat and built-in offline mock mode.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/adapters/react/index.d.ts",
      "import": "./dist/adapters/react/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && cp -r src/demo/public dist/demo/",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "dev": "tsx src/demo/server.ts",
    "start": "node dist/demo/server.js",
    "demo": "tsx src/demo/server.ts"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.10",
    "@types/react": "^18.3.18",
    "react": "^18.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "shopify",
    "storefront",
    "headless",
    "cart",
    "checkout",
    "ecommerce",
    "typescript",
    "framework-agnostic"
  ],
  "license": "MIT"
}
